# ── Gemini AI API Key ──────────────────────────────────────────────
# Get your free API key at https://aistudio.google.com/apikey
# The free tier includes 1,500 requests per day on Gemini 2.0 Flash.
GEMINI_API_KEY=your-gemini-api-key-here

# ── Server Configuration ──────────────────────────────────────────
# PORT defaults to 3001 if not set.
PORT=3001

# ── Frontend Configuration (for .env or Vite) ─────────────────────
# VITE_YOLO_API_URL defaults to http://localhost:3001 in development.
# Set VITE_USE_MOCK_YOLO=true to force mock classification.
# VITE_YOLO_API_URL=http://localhost:3001
# VITE_USE_MOCK_YOLO=false
