# ── Real API-backed build (booth-pin Render version) ──────────────────
# Used by:  npm run build:real   (vite build --mode real)
# Deployed to: snail-sex-identifier-booth (see render.yaml)
#
# Unlike the public version (build = `vite build --mode cycle`), this build
# calls the live API instead of cycling results — so booth pin mode on the
# snail-api-booth server actually gets used. VITE_YOLO_API_URL is injected
# by Render at build time (process env beats .env files); unset locally it
# falls back to .env's URL.
VITE_CYCLE_MODE=false
